# Split Mess Environment Configuration
NODE_ENV=development
PORT=4000

# PostgreSQL 16 Connection String (matches docker-compose.yml)
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/splitmess"

# JWT Authentication (REQUIRED: replace with a strong random 32+ byte secret in production)
JWT_SECRET="replace_with_a_strong_random_secret_at_least_32_characters_long"

# Production Security Settings
# Comma-separated allowed frontend origins in production (e.g. https://splitmess.yourdomain.com)
CORS_ORIGIN=""
# Keep false in production so only admins can add roommates after initial setup
ALLOW_SELF_REGISTRATION=false
# Number of reverse proxies in front of Express (0 if direct, 1 if behind Render/Railway/Nginx/Cloudflare)
TRUST_PROXY_HOPS=0

# Storage
UPLOAD_DIR="./uploads/receipts"
